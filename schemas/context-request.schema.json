{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextRequest",
  "description": "A worker's typed statement that it cannot safely finish from its issued\ncontext. It never grants authority: agentctl resolves it deterministically\ninside the planner-authored envelope or escalates it to the planner.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextRequestItem"
      },
      "maxItems": 16,
      "minItems": 1
    },
    "job_id": {
      "description": "The issued job making the request.",
      "$ref": "#/$defs/JobId"
    },
    "max_bytes": {
      "description": "The most context bytes the worker wants for this round.",
      "type": "integer",
      "format": "uint32",
      "maximum": 32768,
      "minimum": 1
    },
    "reason": {
      "description": "Why the issued context is insufficient. Recorded for the planner only.",
      "type": "string",
      "maxLength": 1024,
      "minLength": 1
    },
    "task_id": {
      "description": "The issued task; absent only for an integration verifier.",
      "anyOf": [
        {
          "$ref": "#/$defs/TaskId"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "$ref": "#/$defs/ProtocolVersion"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "job_id",
    "reason",
    "items",
    "max_bytes"
  ],
  "$defs": {
    "ContextRequestItem": {
      "description": "One deliberately narrow, deterministic question about the repository. There\nis no free-form search: every item names an ontology entity, a literal\nrepository path, or a memory entry, and resolves without a model.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entity_id": {
              "$ref": "#/$defs/GraphEntityId"
            },
            "kind": {
              "type": "string",
              "const": "SYMBOL_DEFINITION"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "entity_id"
          ]
        },
        {
          "description": "Exact name, qualified name, or ID lookup. More than one match fails\nclosed as ambiguous; prefer `SYMBOL_DEFINITION` with an issued ID.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "SYMBOL_BY_NAME"
            },
            "name": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entity_id": {
              "$ref": "#/$defs/GraphEntityId"
            },
            "kind": {
              "type": "string",
              "const": "SYMBOL_RELATIONS"
            },
            "relation": {
              "$ref": "#/$defs/RelationDirection"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "entity_id",
            "relation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entity_id": {
              "$ref": "#/$defs/GraphEntityId"
            },
            "kind": {
              "type": "string",
              "const": "RELATED_TESTS"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "entity_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "depth": {
              "type": "integer",
              "format": "uint8",
              "maximum": 2,
              "minimum": 1
            },
            "entity_id": {
              "$ref": "#/$defs/GraphEntityId"
            },
            "kind": {
              "type": "string",
              "const": "NEIGHBORHOOD"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "entity_id",
            "depth"
          ]
        },
        {
          "description": "One-based, inclusive line range of a captured source file.",
          "type": "object",
          "properties": {
            "end_line": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "kind": {
              "type": "string",
              "const": "FILE_RANGE"
            },
            "path": {
              "type": "string"
            },
            "start_line": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "start_line",
            "end_line"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "MEMORY"
            },
            "memory_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "memory_id"
          ]
        }
      ]
    },
    "GraphEntityId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "JobId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ProtocolVersion": {
      "description": "Required on every top-level document. Unsupported versions fail deserialization.",
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "RelationDirection": {
      "oneOf": [
        {
          "description": "Entities with a resolved relation to the subject.",
          "type": "string",
          "const": "CALLERS"
        },
        {
          "description": "Entities the subject has a resolved relation to.",
          "type": "string",
          "const": "CALLEES"
        }
      ]
    },
    "TaskId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
